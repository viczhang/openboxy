# ==============================================================================
# OpenBoxy Environment Configuration (Personal Edition + MCP Server)
# Copy to .env and fill in your own secrets:
#   cp .env.openboxy.example .env
# ==============================================================================

# 32-byte base64 encryption key:
#   openssl rand -base64 32
KEY_ENCRYPTION_KEY=

# Shared secret between openboxy-mcp and agent-computer:
#   openssl rand -hex 32
COMPUTER_TOKEN=

# Bearer token that external AI clients (Claude Code, Cursor, Antigravity, etc.)
# must send in "Authorization: Bearer <token>" when connecting to /mcp:
#   openssl rand -hex 32
OPENBOXY_MCP_TOKEN=

# Optional public URL shown by the browser_view MCP tool (e.g. https://mcp.example.com)
OPENBOXY_PUBLIC_URL=

# Built-in web UI auth for /, /view, and /view/terminal:
#   token (default): requires OPENBOXY_MCP_TOKEN via /login cookie (works behind any proxy)
#   off: disable built-in login when your reverse proxy / VPN (Tailscale, Cloudflare Access, Authelia, Basic Auth) handles auth
OPENBOXY_UI_AUTH=token

# OpenBot server settings
PORT=3001
SERVER_PORT=3001
TENANT_PACKAGE_DIR=../examples/personal

# CopilotKit Intelligence (required by OpenBot)
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=

# Model provider configuration (OpenAI, OpenRouter, or any OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
BOT_PROVIDER=openai
BOT_MODEL=gpt-4o

# Optional: override the OpenBot image (useful on linux/arm64 where you build locally)
# OPENBOXY_IMAGE=openbot-local:v1.0.2-arm64
