# ==============================================================================
# OpenBoxy Environment Configuration (Single-Container Multi-User MCP + Browser)
# Copy to .env and fill in your own secrets:
#   cp .env.openboxy.example .env
# ==============================================================================

# Default user's API token (maps to user "default"):
#   openssl rand -hex 32
OPENBOXY_MCP_TOKEN=

# Optional additional users (comma or newline separated userId:token pairs):
#   OPENBOXY_USERS=alice:tok_alice_xxx,bob:tok_bob_xxx
# Or JSON map:
#   OPENBOXY_USERS_JSON={"alice":"tok_alice_xxx","bob":"tok_bob_xxx"}
OPENBOXY_USERS=

# Optional public URL shown by browser_view and MCP Setup (e.g. https://mcp.example.com)
OPENBOXY_PUBLIC_URL=

# Built-in web UI auth for /, /view, and /view/terminal:
#   token (default): requires an API token via /login cookie (works behind any proxy)
#   off: disable built-in login when your reverse proxy / VPN handles auth
OPENBOXY_UI_AUTH=token

# Optional idle timeout (minutes) before closing inactive Chromium instances (profile stays saved on disk; 0 = never close)
BROWSER_IDLE_MINUTES=30
